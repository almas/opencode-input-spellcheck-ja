{
  "name": "opencode-input-spellcheck-ja",
  "version": "0.1.0",
  "type": "module",
  "description": "入力欄の日本語选自を JMdict 辞書でチェックし、ローマ字→かな変換と誤変換候補を右クリックで提示するオフラインプラグイン",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/almas/opencode-input-spellcheck-ja.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "spellcheck",
    "japanese",
    "jmdict",
    "romaji",
    "offline"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist",
    "data"
  ],
  "dependencies": {
    "@opencode/plugin": "2.3.0"
  },
  "devDependencies": {
    "jsdom": "^31.0.1",
    "solid-js": "^1.9.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "test": "vitest run",
    "build": "vite build",
    "fetch-data": "node scripts/fetch-data.mjs"
  }
}
